---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/consts";

// The scheduler is Cal.com, embedded on this page so nobody leaves the site to
// book. `calLink` lives in src/consts.ts. The event-type settings that make
// this work well (per-service durations, drop-off-window availability, intake
// questions, confirmation, reminders) are configured in the Cal.com dashboard —
// see README.md › "Booking".
const services = (await getCollection("services"))
  .filter((s) => !s.data.addOn)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Book an appointment" description="Pick a drop-off time at The Pet Affaire in Santa Monica. New clients fill in a short intake; returning clients book in a minute.">
  <Section eyebrow="Book" title="Pick a drop-off time.">
    <div class="-mt-6 mb-10 grid gap-3 sm:max-w-xl sm:grid-cols-2" role="group" aria-label="Are you a new or returning client?">
      <a
        href="/intake"
        class="flex flex-col rounded-2xl border border-black/15 bg-white p-5 transition hover:border-black/40 hover:shadow-md"
      >
        <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-clay)]">I'm new here</span>
        <span class="mt-2 font-display text-xl">Start with the intake</span>
        <span class="mt-2 text-sm text-black/65">Two minutes. Your pet's breed, weight, coat, and temperament, so {SITE.founder.short} is ready for them. Then pick a time.</span>
      </a>
      <a
        href="#scheduler"
        class="flex flex-col rounded-2xl border border-black bg-[var(--color-ink)] p-5 text-[var(--color-cream)] transition hover:bg-black"
      >
        <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-cream)]/70">I've been before</span>
        <span class="mt-2 font-display text-xl">Pick a time below</span>
        <span class="mt-2 text-sm text-[var(--color-cream)]/75">Choose the service and a morning slot. Confirmation and reminders by email and text.</span>
      </a>
    </div>

    <div class="grid gap-8 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="space-y-6 rounded-3xl border border-black/10 bg-white p-6 text-sm text-black/75 lg:sticky lg:top-24">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-black/50">Drop-off &amp; pickup</p>
            <p class="mt-2">Drop-off <strong class="text-black">7:30 – 10:30 AM</strong>, Tuesday to Saturday. Pickup at <strong class="text-black">2 PM</strong>. No kennel waits.</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-black/50">Starting prices</p>
            <ul class="mt-2 space-y-1.5">
              {services.map((s) => (
                <li class="flex justify-between gap-4">
                  <a href={`/services/${s.id}/`} class="hover:underline">{s.data.title}</a>
                  {s.data.priceFrom && <span class="whitespace-nowrap text-black/60">from ${s.data.priceFrom}</span>}
                </li>
              ))}
            </ul>
            <p class="mt-2 text-xs text-black/50">Final price confirmed at drop-off, before we begin.</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-black/50">First visit</p>
            <p class="mt-2">Bring vaccination records: rabies + DHPP for dogs, FVRCP for cats. <a class="underline underline-offset-4 hover:text-black" href="/first-visit">Everything else to know →</a></p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-black/50">Cancellations</p>
            <p class="mt-2">Free up to 24 hours before. Inside 24 hours, a 50% fee.</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-black/50">Rather talk to a person?</p>
            <p class="mt-2">Call {SITE.founder.short} at <a class="underline underline-offset-4 hover:text-black" href={SITE.phoneHref}>{SITE.phone}</a>, Tue – Sat.</p>
          </div>
        </div>
      </aside>

      <div id="scheduler" class="scroll-mt-24 lg:col-span-8">
        <div class="overflow-hidden rounded-3xl border border-black/10 bg-white">
          <div id="cal-inline" style="width:100%;height:760px;overflow:auto;"></div>
          <script type="text/javascript" is:inline define:vars={{ calLink: SITE.calLink, calOrigin: SITE.calOrigin }}>
            (function (C, A, L) {
              let p = function (a, ar) { a.q.push(ar); };
              let d = C.document;
              C.Cal = C.Cal || function () {
                let cal = C.Cal; let ar = arguments;
                if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
                if (ar[0] === L) {
                  const api = function () { p(api, arguments); };
                  const namespace = ar[1]; api.q = api.q || [];
                  if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); }
                  else p(cal, ar); return;
                }
                p(cal, ar);
              };
            })(window, "https://app.cal.com/embed/embed.js", "init");
            Cal("init", "groom", { origin: calOrigin });
            Cal.ns.groom("inline", {
              elementOrSelector: "#cal-inline",
              calLink,
              config: { layout: "month_view", theme: "light" },
            });
            Cal.ns.groom("ui", {
              theme: "light",
              cssVarsPerTheme: {
                light: { "cal-brand": "#1c1a17" },
              },
              hideEventTypeDetails: false,
              layout: "month_view",
            });
          </script>
          <noscript>
            <p class="p-6 text-sm">
              Booking requires JavaScript. Please <a class="underline" href={SITE.bookingUrl}>open the booking page directly</a>
              or call <a class="underline" href={SITE.phoneHref}>{SITE.phone}</a>.
            </p>
          </noscript>
        </div>
        <p class="mt-4 text-xs text-black/50">
          You'll get an email the moment you book, a text reminder the day before, and a text when your pet is ready.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
